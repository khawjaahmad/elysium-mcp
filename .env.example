# --- Network (required) ---------------------------------------------------
# Elysium testnet, from https://elysium.kinetiq.xyz/docs/chain-specifications
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_CHAIN_ID=99801
# Display name only.
# ELYSIUM_CHAIN_NAME=Elysium Testnet

# --- RPC behaviour (optional) --------------------------------------------
# RPC_TIMEOUT_MS=10000
# RPC_RETRY_COUNT=3
# RPC_RETRY_BASE_DELAY_MS=250
# RPC_RATE_LIMIT_RPS=10
# MAX_LOG_BLOCK_RANGE=10000
# BLOCK_TIME_SAMPLE_SIZE=1000

# --- MCP transport (optional) --------------------------------------------
# MCP_TRANSPORT=stdio          # stdio | http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_TOKEN=              # required if MCP_HTTP_HOST is not loopback

# --- Logging (optional) --------------------------------------------------
# LOG_LEVEL=info               # debug | info | warn | error

# --- Writes (phase 2, not implemented yet) -------------------------------
# ENABLE_WRITES=false
