# --- Network (required) ---------------------------------------------------
# Elysium testnet, from https://elysium.kinetiq.xyz/docs/chain-specifications
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_CHAIN_ID=99801
# Display name only.
# ELYSIUM_CHAIN_NAME=Elysium Testnet

# --- RPC behaviour (optional) --------------------------------------------
# RPC_TIMEOUT_MS=10000
# RPC_RETRY_COUNT=3
# RPC_RETRY_BASE_DELAY_MS=250
# RPC_RATE_LIMIT_RPS=10
# MAX_LOG_BLOCK_RANGE=2000
# BLOCK_TIME_SAMPLE_SIZE=1000

# --- MCP transport (optional) --------------------------------------------
# MCP_TRANSPORT=stdio          # stdio | http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_TOKEN=              # required if MCP_HTTP_HOST is not loopback

# --- Logging (optional) --------------------------------------------------
# LOG_LEVEL=info               # debug | info | warn | error

# --- Explorer tools (optional; rely on an undocumented API) --------------
# Off unless set. Testnet explorer: https://elysium.kinetiq.xyz/api/v2
# EXPLORER_API_URL=
# EXPLORER_TIMEOUT_MS=10000
# EXPLORER_RETRY_COUNT=2
# EXPLORER_RATE_LIMIT_RPS=5

# --- Writes (testnet only; read the README's "Risks" section first) -------
# ENABLE_WRITES=false
# A dedicated testnet key holding only what you can afford to lose:
# ELYSIUM_PRIVATE_KEY=
# MAX_SEND_HYPE=0.01
# MAX_FEE_HYPE=0.001
# Comma-separated addresses; unset means any address:
# WRITE_ALLOWLIST=
# WRITE_RECEIPT_TIMEOUT_MS=30000
