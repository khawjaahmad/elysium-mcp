{
  "name": "elysium-chain-mcp",
  "version": "0.1.1",
  "description": "MCP server that lets AI agents read and interact with Elysium, Kinetiq's Layer 2 for Hyperliquid",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elysium",
    "kinetiq",
    "hyperliquid",
    "evm",
    "arbitrum-orbit",
    "viem"
  ],
  "license": "MIT",
  "author": "Ahmad Waqar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khawjaahmad/elysium-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/khawjaahmad/elysium-mcp/issues"
  },
  "homepage": "https://github.com/khawjaahmad/elysium-mcp#readme",
  "type": "module",
  "bin": {
    "elysium-chain-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "~4.1.11"
  }
}
